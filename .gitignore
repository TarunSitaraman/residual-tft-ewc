.env

# LaTeX build outputs
/paper/*.aux
/paper/*.bbl
/paper/*.blg
/paper/*.fdb_latexmk
/paper/*.fls
/paper/*.log
/paper/*.out
/paper/*.pdf
!/paper/paper_single.pdf
/paper/*.synctex.gz

# Cache of converted raw diagnostic files (src/raw_diagnostics.py)
/data/cache/
# Saved forecasts (scripts/run_d30.py), kept outside Git like the data
/data/predictions/

